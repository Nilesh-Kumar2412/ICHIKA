# Environment Configuration for Campus Copilot (ICHIKA)
# Priority: GEMINI_API_KEY > GROQ_API_KEY > LM Studio Local

# ─── Option 1 (Recommended): Google AI Studio — Free Gemma API ───
# Get your key at: https://aistudio.google.com → "Get API key" → "Create API key"
GEMINI_API_KEY="your_gemini_api_key_here"

# ─── Option 2: Groq Cloud — Fast inference ───
# Get your key at: https://console.groq.com/keys
# GROQ_API_KEY="your_groq_api_key_here"

# ─── Option 3: LM Studio Local — Requires laptop running ───
LM_STUDIO_BASE_URL="http://localhost:1234/v1"
LM_STUDIO_API_KEY="lm-studio"
LM_STUDIO_MODEL="google/gemma-4-12b-qat"

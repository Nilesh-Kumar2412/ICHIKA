Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://vtopcc.vit.ac.in/vtop/assets/css/VTop.css

@charset "windows-1252";

@font-face { font-family: OpenSans; src: url("../fonts/OpenSans-Regular.ttf"); }

.fg-black { color: rgb(0, 0, 0); }

.panel-body { background-color: rgb(255, 255, 255); }

.b3ModalLayer { z-index: 30000000; }

html { height: 100%; overflow: hidden; }

body { min-height: 100vh; overflow: scroll; }

html, body { font-family: OpenSans; font-size: 14px; }

#core-container { overflow: hidden; height: 100vh; margin-top: -100px; padding-top: 100px; position: relative; width: 100%; backface-visibility: hidden; will-change: overflow; }

#sidepanel { overflow: auto; height: auto; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

.img-circle { border-radius: 50%; }

.rounded_corner15 { border-radius: 15%; }

body { background-color: rgb(236, 240, 241); }

.websiteBackground { background-color: rgb(238, 238, 238); }

.WhiteBackground { background-color: rgb(255, 255, 255); }

.goldBackground { background: linear-gradient(90deg, rgb(204, 198, 173), rgb(204, 198, 171), rgb(204, 197, 168), rgb(205, 197, 166), rgb(205, 196, 164), rgb(205, 196, 162), rgb(206, 195, 159), rgb(206, 195, 157)); }

.trim { padding: 0px; margin: 0px; }

.trim-h { padding-left: 0px; padding-right: 0px; }

.textColor1 { color: rgb(0, 0, 0); }

.textColor2 { color: rgb(0, 0, 0); }

.primaryColor1 { color: rgb(51, 122, 183); }

.primaryColor2 { color: rgb(59, 142, 214); }

.primaryFontStyle { font-family: OpenSans; }

.primaryMenuFontStyle { font-family: OpenSans; }

.primaryBorderTop { border-width: 3px 0px 0px; border-style: solid; border-color: rgb(92, 172, 218); }

.warningBorderTop { border-width: 3px 0px 0px; border-style: solid; border-color: rgb(230, 126, 34); }

.successBorderTop { border-width: 3px 0px 0px; border-style: solid; border-color: rgb(82, 190, 128); }

.dangerBorderTop { border-width: 3px 0px 0px; border-style: solid; border-color: rgb(192, 57, 43); }

.primaryBorderBottom { border-width: 0px 0px 3px; border-style: solid; border-color: rgb(92, 172, 218); }

.headerBackgroundColor { background: linear-gradient(130deg, rgb(36, 85, 163) 23%, rgb(52, 151, 219) 52%, rgb(52, 142, 219) 58%, rgb(52, 131, 219) 65%, rgb(40, 116, 166) 74%); }

.hightlight1 { color: rgb(144, 12, 63); }

.VTopHeaderStyle { color: white; font-weight: bold; font-family: arial; }

.SwitchRoleBorder { border-width: 3px 0px 0px; border-style: solid; border-color: rgb(255, 165, 0); }

.VITLogoStyle { font-family: Times; }

@media screen and (min-width: 768px) {
  .VITEmblem { width: 40px; height: 40px; }
}

@media screen and (max-width: 767px) {
  .VITEmblem { width: 30px; height: 30px; }
}

.img_icon_size { width: 40px; height: 40px; }

.img_stamp_size { width: 100px; height: 100px; }

.trim { padding: 0px; margin: 0px; }

ul.news-slice { list-style-type: circle; font-family: OpenSans; width: 100%; }

.news_card_text { font-family: OpenSans; font-size: 12px; font-weight: bold; margin: 3px; }

.info-box-number { font-family: arial; font-size: 15px; font-weight: bold; }

.info-box { padding: 0px; margin: 0px; border-width: 2px 0px 0px; border-color: orange; border-style: solid; display: inline-block; }

.info-box-size { width: 300px; }

.noshow { display: none; }

.showBlock { display: block; }

.content-center { float: none; margin: 0px auto; }

#chatbot-button { position: fixed; bottom: 20px; right: 20px; background-color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; width: 60px; height: 60px; z-index: 1000; cursor: pointer; }

#chatbot-icon { width: 100%; height: 100%; border-radius: 50%; }

#chatbot-chat { display: none; position: fixed; bottom: 80px; right: 20px; width: 350px; height: 540px; border: 1px solid rgb(204, 204, 204); border-radius: 8px; z-index: 1000; box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 10px; background-color: white; overflow: hidden; }

#chatbot-chat .header { background-color: rgb(0, 102, 255); color: white; padding: 10px; text-align: center; font-weight: bold; }

#chatbot-chat .messages { height: 400px; overflow-y: auto; padding: 10px; }

#chatbot-chat .messages ul { list-style-type: none; }

#chatbot-chat .messages li { list-style-type: none; }

#chatbot-chat .input { padding: 10px; border-top: 1px solid rgb(204, 204, 204); display: flex; }

#chatbot-chat input[type="text"] { flex: 1 1 0%; padding: 5px; border: 1px solid rgb(204, 204, 204); border-radius: 4px; }

.chat-outgoing p { background-color: rgb(22, 40, 135); align-self: flex-end; color: rgb(255, 255, 255); }

.chat-incoming p { background-color: rgb(234, 234, 234); }

#chatbot-chat button { margin-left: 10px; padding: 5px 10px; background-color: rgb(0, 102, 255); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 4px; cursor: pointer; }

#chatbot-chat .note { background-color: rgb(248, 249, 250); font-size: 10px; }

.portal-wrapper { border: 3px solid rgb(123, 153, 201); box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px; border-radius: 20px; padding: 4px; position: relative; overflow: hidden; margin: 15px; }

.portal-circle-top { position: absolute; top: -60px; right: -60px; width: 200px; height: 200px; background: rgba(255, 255, 255, 0.05); border-radius: 50%; pointer-events: none; }

.portal-circle-bottom { position: absolute; bottom: -80px; left: 20px; width: 250px; height: 250px; background: rgba(255, 255, 255, 0.04); border-radius: 50%; pointer-events: none; }

.portal-inner { background: rgba(255, 255, 255, 0.97); border-radius: 14px; padding: 20px; position: relative; z-index: 2; }

.portal-header { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }

.portal-title-box { flex: 1 1 0%; }

.portal-title { font-size: 22px; font-weight: 700; color: rgb(255, 255, 255); margin: 0px 0px 3px; letter-spacing: 0.2px; line-height: 1.2; text-align: center; }

.portal-subtitle { font-size: 12px; font-weight: 400; color: rgb(107, 122, 153); margin: 0px; letter-spacing: 0.3px; }

.portal-badge { background: rgb(230, 240, 252); color: rgb(26, 79, 160); font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 20px; letter-spacing: 0.4px; border: 1px solid rgba(26, 79, 160, 0.18); white-space: nowrap; }

.portal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px 10px; }

.portal-card { position: relative; overflow: hidden; transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.22s, box-shadow 0.28s, background 0.22s; background: rgb(255, 255, 255); border: 1px solid rgb(220, 230, 245); border-radius: 12px; padding: 16px 8px 14px; display: flex; flex-direction: column; align-items: center; gap: 9px; cursor: pointer; text-decoration: none; color: inherit; }

.portal-card::before { content: ""; position: absolute; top: 0px; left: -100%; width: 60%; height: 2.5px; background: linear-gradient(90deg, transparent, rgb(74, 158, 255), transparent); transition: left 0.45s; }

.portal-card::after { content: ""; position: absolute; inset: 0px; border-radius: inherit; background: radial-gradient(at 50% 0%, rgba(40, 120, 216, 0.08) 0%, transparent 70%); opacity: 0; transition: opacity 0.3s; pointer-events: none; }

.portal-card:hover { transform: translateY(-7px) scale(1.03); border-color: rgb(40, 120, 216); background: rgb(255, 255, 255); box-shadow: rgba(26, 79, 160, 0.08) 0px 4px 6px, rgba(26, 79, 160, 0.22) 0px 10px 28px, rgba(40, 120, 216, 0.15) 0px 0px 0px 1px; }

.portal-card:hover::before { left: 120%; }

.portal-card:hover::after { opacity: 1; }

.portal-card:active { transform: translateY(-3px) scale(1.01); transition-duration: 0.1s; }

.portal-img-box { width: 120px; height: 120px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }

.portal-img { width: 100%; height: 100%; object-fit: contain; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }

.portal-card:hover .portal-img { transform: scale(1.12); }

.portal-name { font-size: 12px; font-weight: 600; color: rgb(44, 62, 106); text-align: center; line-height: 1.3; }

.section-divider { display: flex; align-items: center; gap: 10px; margin: 20px 0px 0px; visibility: hidden; }

.section-divider::before, .section-divider::after { content: ""; flex: 1 1 0%; height: 1px; background: linear-gradient(90deg, transparent, rgb(200, 217, 240), transparent); }

.section-divider span { font-size: 11px; font-weight: 600; color: rgb(107, 122, 153); letter-spacing: 0.8px; text-transform: uppercase; background: rgb(240, 245, 251); padding: 4px 12px; border-radius: 20px; border: 1px solid rgb(220, 230, 245); white-space: nowrap; }

